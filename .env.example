APP_NAME=Cabin Security Management API
ENVIRONMENT=development
POSTGRES_DB=cabin_security
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_THIS_DATABASE_PASSWORD@db:5432/cabin_security
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
DEVICE_API_KEY_PEPPER=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
PIN_LENGTH=6
COMMAND_DEFAULT_TTL_SECONDS=120
DEVICE_OFFLINE_AFTER_SECONDS=60
CORS_ORIGINS=http://localhost:5173
