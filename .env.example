# Copy this file to .env and replace the development values.
APP_NAME=Cabin Security Management API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Development-only values for the included Docker Compose PostgreSQL service.
CONTROL_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cabin_control
TENANT_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
TENANT_PASSWORD_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET
PROVISION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Generate a strong value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Use exact frontend origins in production. These are convenient local development origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_PRIVATE_LAN_ORIGINS=true

# Owner self-registration is available through POST /api/v1/auth/register.
ALLOW_OWNER_REGISTRATION=false
DEVICE_COMMAND_LEASE_SECONDS=20
DEVICE_ONLINE_WINDOW_SECONDS=45
